{
  "name": "kilo-bridge",
  "version": "1.0.0",
  "description": "Kilo Bridge V1.0 - Universal AI Development Coordinator connecting ChatGPT, GitHub, local workspaces and the Kilo Code coding agent.",
  "repository": {
    "type": "git",
    "url": "https://github.com/nabeel2323/kilo-bridge"
  },
  "license": "MIT",
  "author": "Kilo Bridge Project",
  "bin": {
    "kilo-bridge": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "watch": "tsc -p tsconfig.json --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "pnpm build && pnpm build:test && node --test dist-test/tests/**/*.test.js",
    "test:coverage": "pnpm build && pnpm build:test && node --test --experimental-test-coverage dist-test/tests/**/*.test.js",
    "doctor": "node dist/cli.js doctor",
    "init": "node dist/cli.js init",
    "start": "node dist/cli.js start",
    "stop": "node dist/cli.js stop",
    "status": "node dist/cli.js status",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "os": [
    "win32"
  ],
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "sql.js": "^1.11.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.0.0",
    "@types/sql.js": "^1.4.11",
    "typescript": "~5.6.0"
  }
}
