{
  "$schema": "https://app.kilo.ai/config.json",
  "provider": {
    "local-test": {
      "name": "Kilo Bridge Local Test Provider",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:19792/v1"
      },
      "models": {
        "local-model": {
          "name": "Kilo Bridge Deterministic Local Provider",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "write": "allow",
    "bash": "deny",
    "lsp": "deny",
    "todoread": "deny",
    "todowrite": "deny"
  },
  "disabled_providers": []
}
